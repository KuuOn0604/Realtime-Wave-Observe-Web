# copy vào backend/.env

# Server
PORT=3000
NODE_ENV=development

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# AI Microservice
AI_SERVICE_URL=http://127.0.0.1:8000

# Sensor Hardware (chỉ dùng khi NODE_ENV=production)
# Dev mode: bỏ trống — MockSensorReader tự động hoạt động
# Prod mode: điền COM port thực tế (ví dụ: COM3 trên Windows, /dev/ttyUSB0 trên Linux)
SENSOR_PORT=
SENSOR_BAUD_RATE=9600
SENSOR_ID=sensor_01
